# Salin menjadi .env.local (lokal) atau isi di Environment Variables Vercel.

# Connection string Neon (pakai yang -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret sesi login, min 32 karakter acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Secret endpoint cron (dikirim sebagai: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Web Push VAPID — buat dengan: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kamu@email.com"

# Hanya untuk script seed (pnpm db:seed)
SEED_USERNAME="queens"
SEED_PASSWORD=""

APP_TIMEZONE="Asia/Jakarta"
